# =====================================================
# מערכת ניהול התנדבות — קובץ הגדרות סביבה
# העתק קובץ זה ל-.env ומלא את הערכים
# cp .env.example .env
# =====================================================

# -------------------------------------------------------
# מסד נתונים (PostgreSQL)
# -------------------------------------------------------
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=salon_pass
POSTGRES_DB=salon_db

# DATABASE_URL נבנה אוטומטית ב-docker-compose.
# אם מריצים את השרת מחוץ ל-Docker — מלאו כאן:
DATABASE_URL=postgresql+asyncpg://salon_user:salon_pass@localhost:5432/salon_db

# -------------------------------------------------------
# אבטחה / JWT
# -------------------------------------------------------
# צרו מחרוזת רנדומלית חזקה:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-before-production
ALGORITHM=HS256
# משך תוקף טוקן בדקות (ברירת מחדל: 480 = 8 שעות)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -------------------------------------------------------
# CORS — מאיזה כתובות Frontend מורשה לפנות לשרת
# מופרד בפסיקים
# -------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------
# יעד שעות מתנדב (ברירת מחדל: 60)
# -------------------------------------------------------
VOLUNTEER_GOAL_HOURS=60

# -------------------------------------------------------
# שעות משמרות (label בלבד — לא לוגיקה)
# -------------------------------------------------------
SHIFT_MORNING_START=10:00
SHIFT_MORNING_END=14:00
SHIFT_AFTERNOON_START=14:00
SHIFT_AFTERNOON_END=18:00
SHIFT_EVENING_START=18:00
SHIFT_EVENING_END=22:00

# -------------------------------------------------------
# משתמש מנהל ראשוני (נוצר אוטומטית בהפעלה ראשונה)
# -------------------------------------------------------
FIRST_ADMIN_PHONE=0501234567
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_NAME=מנהל ראשי


# -------------------------------------------------------
# SMS / התראות חיצוניות (אופציונלי — להשאיר ריק לעת עתה)
# -------------------------------------------------------
SMS_PROVIDER_URL=
SMS_API_KEY=
